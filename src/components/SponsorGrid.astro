---
import { withBase } from '../utils/url';
import { sponsors } from '../data/sponsors';
---
<div class="sponsors">
  {sponsors.map((s) =>
    s.url ? (
      <a href={s.url} rel="noopener" title={s.name}><img src={withBase(`/images/site/${s.logo}`)} alt={s.name} loading="lazy" /></a>
    ) : (
      <div title={s.name}><img src={withBase(`/images/site/${s.logo}`)} alt={s.name} loading="lazy" /></div>
    )
  )}
</div>
