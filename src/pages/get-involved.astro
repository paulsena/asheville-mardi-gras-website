---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import MailForm from '../components/MailForm.astro';
import { links } from '../data/site';
---
<Base title="Get Involved" description="Become a member, volunteer, donate, or play with the Asheville Second Line band.">
  <PageHero eyebrow="Get Involved" title="Pick your role in the parade" lede="There are a lot of ways to get involved at Asheville Mardi gras. Look around and see what suits you!" />
  <section class="section" style="padding-top:0">
    <div class="wrap cards">
      <article class="card">
        <img src="/images/site/involved-members.webp" alt="members" width="1080" height="1065" />
        <div class="card-body">
          <h3>Become a member</h3>
          <p>Membership has its perks and we have membership options to fit all budgets and situations. Click through and explore the benefits of Membership.</p>
          <a class="btn btn--sm btn--purple" href="/membership">More Info</a>
        </div>
      </article>
      <article class="card">
        <img src="/images/site/cleanup.webp" alt="helping clean up" width="720" height="960" />
        <div class="card-body">
          <h3>Volunteer</h3>
          <p>Show up for an hour or join the executive board. We have options for any and all interests.</p>
          <a class="btn btn--sm btn--purple" href="/volunteer">More Info</a>
        </div>
      </article>
      <article class="card">
        <img src="/images/site/involved-donate.webp" alt="donate" width="1000" height="1000" />
        <div class="card-body">
          <h3>Donate $$$</h3>
          <p>We can always use donations. Parades don't grow on trees. Asheville Mardi Gras relies on the support of its members and donors to operate. As a 501(c)(3) organization, all donations are completely tax deductible.</p>
          <a class="btn btn--sm" href={links.donate} rel="noopener">Donate</a>
        </div>
      </article>
      <article class="card">
        <img src="/images/site/second-line-band.webp" alt="A2L" width="720" height="448" />
        <div class="card-body">
          <h3>A2L</h3>
          <p>So you think you're a player? They're crazy, They're fun and they all got musical skills. Click through to get more info on the Asheville Second Line Band.</p>
          <a class="btn btn--sm btn--purple" href="/second-line">More Info</a>
        </div>
      </article>
    </div>
  </section>
  <section class="section section--parchment">
    <div class="wrap narrow center">
      <h2>Join our mailing list!</h2>
      <MailForm subject="Add me to the Asheville Mardi Gras mailing list" submitLabel="Sign me up" class="inline-form">
        <label class="visually-hidden" for="gi-email">Email address</label>
        <input id="gi-email" type="email" name="email" placeholder="you@example.com" required />
      </MailForm>
    </div>
  </section>
</Base>
